digraph G {
  graph [rankdir=LR, compound=true, fontname="DejaVu Sans", fontsize=13, labelloc=t, label=<<b>Llama on cloud AI platforms: one model family, three operators, three end-of-life dates</b>>, fontcolor="#1F3864", nodesep=0.3, ranksep=0.55, pad=0.25];
  node [shape=box, style="rounded,filled", fillcolor="#F4F8FC", color="#1F3864", fontname="DejaVu Sans", fontsize=10, fontcolor="#1F3864", margin="0.12,0.05"];
  edge [color="#2E4A6B", fontname="DejaVu Sans", fontsize=9];
  subgraph cluster_e2a { label=<<b>E2A service</b>>; style="rounded,filled"; fillcolor="#EAF2FA"; color="#2E75B6";
    llm [label="llm_service\n(model id from configuration)"];
    rt [label="model_routes\n(non-Llama fallback)"];
    lc [label="release pipeline:\nlifecycle check"];
  }
  subgraph cluster_aws { label=<<b>Amazon Bedrock (AWS)</b>>; style="rounded,filled"; fillcolor="#E6F4F5"; color="#0F7C8C"; fontcolor="#0F5C66";
    b [label="Llama 4 Maverick, Llama 3.3 70B\nLEGACY: end of life 30 Mar 2027"];
  }
  subgraph cluster_g { label=<<b>Gemini Enterprise Agent Platform (Google)</b>>; style="rounded,filled"; fillcolor="#E6F4F5"; color="#0F7C8C"; fontcolor="#0F5C66";
    g [label="Llama 4 Maverick / Scout MaaS\nGA; no date on the model card"];
  }
  subgraph cluster_az { label=<<b>Microsoft Foundry (Microsoft)</b>>; style="rounded,filled"; fillcolor="#E6F4F5"; color="#0F7C8C"; fontcolor="#0F5C66";
    a [label="Maverick: retires 19 Nov 2026\nScout, Llama 3.3 70B: 31 Jan 2027"];
  }
  llm -> b; llm -> g; llm -> a; rt -> llm [style=dashed]; lc -> llm [style=dashed, xlabel="fails a retired id"];
}
