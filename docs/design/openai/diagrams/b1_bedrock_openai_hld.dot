digraph G {
  graph [rankdir=LR, compound=true, fontname="DejaVu Sans", fontsize=13, labelloc=t, label=<<b>OpenAI on Amazon Bedrock: AWS services fill the hosted features Bedrock does not offer</b>>, fontcolor="#1F3864", nodesep=0.3, ranksep=0.55, pad=0.25];
  node [shape=box, style="rounded,filled", fillcolor="#F4F8FC", color="#1F3864", fontname="DejaVu Sans", fontsize=10, fontcolor="#1F3864", margin="0.12,0.05"];
  edge [color="#2E4A6B", fontname="DejaVu Sans", fontsize=9];
  subgraph cluster_e2a { label=<<b>E2A service (customer cloud)</b>>; style="rounded,filled"; fillcolor="#EAF2FA"; color="#2E75B6";
    llm [label="OpenAIResponsesLLMService\n(Bedrock client, SigV4)"];
    rt [label="ResponsesAgentRuntime\nor AgentCoreRuntime"];
    gov [label="governance stage\n(fail closed)"];
    tools [label="tools run host-side\n(tenant-scoped)"];
  }
  subgraph cluster_bed { label=<<b>Amazon Bedrock (AWS operates; content not shared with OpenAI)</b>>; style="rounded,filled"; fillcolor="#E6F4F5"; color="#0F7C8C"; fontcolor="#0F5C66";
    rtm [label="bedrock-runtime\nus. / global. inference profiles"];
    man [label="bedrock-mantle\nzero operator access"];
    bma [label="Bedrock Managed Agents\n(preview, option)"];
  }
  subgraph cluster_aws { label=<<b>AWS services in place of OpenAI-hosted features</b>>; style="rounded,filled"; fillcolor="#F2F2F2"; color="#7F7F7F";
    s3v [label="Titan + S3 Vectors + Rerank\n(no hosted file search)"];
    gw [label="AgentCore Gateway\n(no remote MCP)"];
    gr [label="Bedrock Guardrails\n(ApplyGuardrail stage)"];
  }
  llm -> rtm; llm -> man; rt -> bma [style=dashed, xlabel="option"];
  tools -> gw; tools -> s3v; gov -> gr;
}
