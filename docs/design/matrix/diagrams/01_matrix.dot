digraph G {
  graph [fontname="DejaVu Sans", fontsize=13, labelloc=t, label=<<b>Model family × cloud: what exists, and what this repository implements</b>>, fontcolor="#1F3864", pad=0.25];
  node [shape=plaintext, fontname="DejaVu Sans", fontsize=10];
  m [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="6" color="#B8C4D6"><tr><td bgcolor="#1F3864"><font color="white"><b>Model family</b></font></td><td bgcolor="#1F3864"><font color="white"><b>AWS</b></font></td><td bgcolor="#1F3864"><font color="white"><b>Google Cloud</b></font></td><td bgcolor="#1F3864"><font color="white"><b>Microsoft Azure</b></font></td><td bgcolor="#1F3864"><font color="white"><b>Provider's own API</b></font></td><td bgcolor="#1F3864"><font color="white"><b>Self-hosted (customer)</b></font></td></tr><tr><td bgcolor="#F4F8FC" align="left"><font color="#1F3864"><b>Claude<br/>(Anthropic)</b></font></td><td bgcolor="#D5EFE3" align="left" valign="top"><font color="#1E7B4F"><b>Implemented</b></font><br/>Bedrock (P3) anthropic_bedrock<br/>Claude Platform on AWS (P2)<br/>anthropic_claude_platform_aws</td><td bgcolor="#E3EDF8" align="left" valign="top"><font color="#2E75B6"><b>Documented</b></font><br/>Agent Platform, Google-managed (P3)<br/>Anthropic-managed on Google Cloud (P2)</td><td bgcolor="#E3EDF8" align="left" valign="top"><font color="#2E75B6"><b>Documented</b></font><br/>Microsoft Foundry (P2): hosted<br/>on Azure or on Anthropic</td><td bgcolor="#E3EDF8" align="left" valign="top"><font color="#2E75B6"><b>Documented</b></font><br/>Claude API (P1)</td><td bgcolor="#EFEFEF" align="left" valign="top"><font color="#8A8A8A"><b>Not offered</b></font><br/>closed weights</td></tr><tr><td bgcolor="#F4F8FC" align="left"><font color="#1F3864"><b>OpenAI GPT</b></font></td><td bgcolor="#E3EDF8" align="left" valign="top"><font color="#2E75B6"><b>Documented</b></font><br/>Bedrock Runtime and Mantle (P3)</td><td bgcolor="#FCEFD7" align="left" valign="top"><font color="#B7791F"><b>To validate</b></font><br/>frontier models: private preview (P3)<br/>gpt-oss-120b managed API: Documented</td><td bgcolor="#D5EFE3" align="left" valign="top"><font color="#1E7B4F"><b>Implemented</b></font><br/>Microsoft Foundry (P3)<br/>openai_azure</td><td bgcolor="#E3EDF8" align="left" valign="top"><font color="#2E75B6"><b>Documented</b></font><br/>OpenAI API (P1)</td><td bgcolor="#FCEFD7" align="left" valign="top"><font color="#B7791F"><b>To validate</b></font><br/>gpt-oss open weights<br/>behind OGX (P5)</td></tr><tr><td bgcolor="#F4F8FC" align="left"><font color="#1F3864"><b>Gemini<br/>(Google)</b></font></td><td bgcolor="#E3EDF8" align="left" valign="top"><font color="#2E75B6"><b>Documented</b></font><br/>not offered in AWS;<br/>remote from AWS (P4)</td><td bgcolor="#D5EFE3" align="left" valign="top"><font color="#1E7B4F"><b>Implemented</b></font><br/>Agent Platform (P3)<br/>google_vertex</td><td bgcolor="#E3EDF8" align="left" valign="top"><font color="#2E75B6"><b>Documented</b></font><br/>not offered in Azure;<br/>remote from Azure (P4)</td><td bgcolor="#E3EDF8" align="left" valign="top"><font color="#2E75B6"><b>Documented</b></font><br/>Gemini Developer API (P1)</td><td bgcolor="#EFEFEF" align="left" valign="top"><font color="#8A8A8A"><b>Not offered</b></font><br/>closed weights</td></tr><tr><td bgcolor="#F4F8FC" align="left"><font color="#1F3864"><b>Llama<br/>(Meta)</b></font></td><td bgcolor="#D5EFE3" align="left" valign="top"><font color="#1E7B4F"><b>Implemented</b></font><br/>Bedrock (P3) behind OGX<br/>ogx_aws; Legacy, EOL 30 Mar 2027</td><td bgcolor="#E3EDF8" align="left" valign="top"><font color="#2E75B6"><b>Documented</b></font><br/>Agent Platform managed API (P3)</td><td bgcolor="#E3EDF8" align="left" valign="top"><font color="#2E75B6"><b>Documented</b></font><br/>Microsoft Foundry (P3)<br/>retiring: Maverick 19 Nov 2026,<br/>Scout 31 Jan 2027</td><td bgcolor="#EFEFEF" align="left" valign="top"><font color="#8A8A8A"><b>Not covered</b></font><br/>no Meta-operated API<br/>documented here</td><td bgcolor="#FCEFD7" align="left" valign="top"><font color="#B7791F"><b>To validate</b></font><br/>OGX + vLLM or Ollama (P5)<br/>ogx_aws server Implemented</td></tr><tr><td colspan="6" align="left" bgcolor="white"><font point-size="9">P1 direct provider API · P2 provider platform through a cloud account · P3 cloud-operated · P4 remote from another cloud · P5 self-hosted (core design §3.2)</font></td></tr></table>>];
}
