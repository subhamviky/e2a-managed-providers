# ogx_aws: OGX (formerly Llama Stack) on aws
E2A_PROVIDER_PROFILE=ogx_aws
LLM_MODEL_ID=meta.llama4-maverick-17b-instruct-v1:0
LLM_FALLBACK_MODEL_ID=
LLM_TEMPERATURE=0.0
OGX_URL=http://ogx.internal:8321
OGX_API_KEY=   # secret, only if the server's auth uses a key: inject at runtime
OGX_SERVICE_TENANT=e2a-service
OGX_GUARDRAILS=false
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
AWS_REGION=us-east-1
LLM_MAX_LATENCY=60
LLM_CONTEXT_BUDGET=120000
LLM_MAX_OUTPUT_TOKENS=4096
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
VECTOR_INDEX_NAME=e2a-knowledge
DELEGATED_RUNTIME_ID=
DYNAMODB_IDEMPOTENCY_TABLE=e2a-idempotency
DYNAMODB_CHECKPOINT_TABLE=e2a-checkpoints
OTEL_SERVICE_NAME=e2a-service
