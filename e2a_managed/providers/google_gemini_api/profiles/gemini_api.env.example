# gemini_api: Gemini Developer API (free tier) on Google Cloud's Always Free infrastructure (GCP-01)
E2A_PROVIDER_PROFILE=gemini_api
# AI Studio key: on Cloud Run a Secret Manager secret mounted as this variable; never committed
GEMINI_API_KEY=
LLM_MODEL_ID=gemini-3.6-flash
LLM_FALLBACK_MODEL_ID=
LLM_REASONING_EFFORT=low
LLM_TEMPERATURE=0.0
LLM_MAX_LATENCY=60
LLM_CONTEXT_BUDGET=60000
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RPM=8
LLM_MAX_TPM=200000
GEMINI_MAX_REQUESTS_PER_DAY=200
LLM_SDK_MAX_RETRIES=2
EMBEDDING_MODEL_ID=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=e2a
OTEL_SERVICE_NAME=e2a-service
