# openai_azure: openai on azure
E2A_PROVIDER_PROFILE=openai_azure
LLM_MODEL_ID=gpt-5
LLM_FALLBACK_MODEL_ID=
LLM_REASONING_EFFORT=medium
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=   # secret: inject at runtime
MCP_SERVERS=[]
LLM_MAX_LATENCY=60
LLM_CONTEXT_BUDGET=150000
LLM_MAX_OUTPUT_TOKENS=4096
EMBEDDING_MODEL_ID=text-embedding-3-large
EMBEDDING_DIMENSIONS=1024
VECTOR_INDEX_NAME=e2a-knowledge
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=   # secret: inject at runtime
AZURE_SEARCH_SEMANTIC_CONFIG=default
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=   # secret: inject at runtime
APIM_MCP_URL=
DELEGATED_RUNTIME_ID=
COSMOS_ENDPOINT=
COSMOS_DATABASE=e2a
OTEL_SERVICE_NAME=e2a-service
